# AWS Amplify Configuration
# Amplifyデプロイ後に自動生成される amplify_outputs.json から値を取得

# AWS Region
NEXT_PUBLIC_AWS_REGION=us-east-1

# Cognito User Pool (amplify_outputs.jsonから取得)
NEXT_PUBLIC_USER_POOL_ID=<your-cognito-user-pool-id>
NEXT_PUBLIC_USER_POOL_CLIENT_ID=<your-cognito-client-id>

# Amazon Bedrock
AWS_BEDROCK_REGION=us-east-1
AWS_BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0

# Amazon S3 (amplify_outputs.jsonから取得)
S3_BUCKET_NAME=<your-s3-bucket-name>
S3_REGION=us-east-1

# CloudFront (デプロイ後に設定)
CLOUDFRONT_DOMAIN=<your-cloudfront-domain>

# Development Settings
NODE_ENV=development
